    - target: {fileID: 8597441649242730954, guid: 964253ca612f3d7418844c5542fbb488, type: 3}
      propertyPath: m_text
      value: "\uD314\uB808\uD2B8 \uD074\uB9AD\xB7\uB4DC\uB798\uADF8  \uB8EC \uBC30\uCE58\n\uB178\uB4DC
        \uB4DC\uB798\uADF8  \uC704\uCE58 \uC774\uB3D9\n\uD3EC\uD2B8 \uB4DC\uB798\uADF8 
        \uC5F0\uACB0\n\uD720  \uD655\uB300\xB7\uCD95\uC18C\n\uAC00\uC6B4\uB370 \uBC84\uD2BC\xB7\uBE48
        \uACF5\uAC04 \uC6B0\uD074\uB9AD \uB4DC\uB798\uADF8  \uD654\uBA74 \uC774\uB3D9\nShift+\uD074\uB9AD 
        \uC5EC\uB7EC \uB178\uB4DC \uC120\uD0DD\n\uC5F0\uACB0\uC120 \uC6B0\uD074\uB9AD 
        \uC5F0\uACB0 \uC0AD\uC81C\nDelete / Backspace  \uB178\uB4DC \uC0AD\uC81C\nCtrl+C
        / Ctrl+V  \uBCF5\uC0AC\xB7\uBD99\uC5EC\uB123\uAE30\nCtrl+D  \uBCF5\uC81C\nCtrl+Z
        / Ctrl+Y  \uC2E4\uD589 \uCDE8\uC18C\xB7\uB2E4\uC2DC \uC2E4\uD589\nCtrl+S 
        \uC800\uC7A5\n\uC22B\uC790 1  \uC2DC\uD5D8 \uC2DC\uC804  /  R  \uB3C4\uD06C
        \uCD08\uAE30\uD654"
